# Copy this file to .env and change the values.  NEVER commit .env to Git.
# Generate a secret key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true only when the site is served over HTTPS (on the lab server)
SESSION_COOKIE_SECURE=false

# Maximum upload size in MB
MAX_UPLOAD_MB=50

# Keep uploaded meeting videos after analysis? (privacy: false recommended)
KEEP_UPLOADED_VIDEOS=false

# Deepfake model: "mesonet" (real model) or "dummy" (tests only)
DETECTOR_BACKEND=mesonet

# Local development only - never on a shared server
FLASK_DEBUG=0
